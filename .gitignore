# dependencies — restored with `npm install`
node_modules/

# build output — regenerated with `npm run build`
dist/
dist-ssr/

# local env files, should never be committed
.env
.env.*
!.env.example

# editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.njsproj
*.sln
*.sw?

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
